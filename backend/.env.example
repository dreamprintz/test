# --- Server ---
PORT=8787
# Shared secret the extension sends as "Authorization: Bearer <key>". Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKEND_API_KEY=
# Optional: comma-separated origins allowed by CORS, e.g. chrome-extension://<your-extension-id>
# (Extensions with host permission don't need CORS, so this can stay empty.)
ALLOWED_ORIGINS=
# Where message state is persisted (JSON file). Keep it on durable storage.
DATA_DIR=./data

# --- Meta WhatsApp Business Platform (Cloud API) ---
# Use a System User access token with whatsapp_business_messaging permission.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v23.0
# App secret, used to verify X-Hub-Signature-256 on webhooks.
META_APP_SECRET=
# Any random string; enter the same value in the Meta app's webhook settings.
META_WEBHOOK_VERIFY_TOKEN=

# Inbound replies matching these words (case-insensitive, whole message) are recorded as opt-outs.
OPT_OUT_KEYWORDS=STOP,STOP ALL,UNSUBSCRIBE,OPT OUT,OPTOUT
